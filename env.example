# Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Free tier: flash-lite is fast and has a usable daily quota; gemini-flash-latest
# is capped at 20 requests/day on the free tier.
GEMINI_MODEL=gemini-flash-lite-latest
# low | medium | high, or empty for models without thinking levels
GEMINI_THINKING_LEVEL=low

# Qdrant vector index. With URL + key set, Qdrant Cloud is used; otherwise an
# on-disk store at QDRANT_PATH (default backend/.qdrant). Build it with:
#   cd backend && py scripts/scrape_and_index.py
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_MODE=local   # force the on-disk store even when cloud is configured

# Optional: use a separately running MCP server instead of the in-process one
# MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Optional: hostnames allowed to reach /mcp when deployed (comma-separated, or *)
# MCP_ALLOWED_HOSTS=terpy.example.com
# Optional: allowed frontend origins for CORS (comma-separated, default *)
# FRONTEND_ORIGINS=http://localhost:3000
